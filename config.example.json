        "altitude_m": {
            "enabled": true,
            "visible": true,
            "threshold_min": 0.0,
            "threshold_max": 1000.0,
            "unit": "m",
            "display_name": "Altitude",
            "category": "position"
        },
        "voltage_V": {
            "enabled": true,
            "visible": true,
