{
    "mqtt": {
        "broker": "YOUR_HIVEMQ_BROKER_URL",
        "port": 8883,
        "username": "YOUR_MQTT_USERNAME",
        "password": "YOUR_MQTT_PASSWORD",
        "use_tls": true,
        "topic": "parveenesp32/sensor_data"
    },
    "parameters": {
        "helium_pressure_mbar": {
            "enabled": true,
            "visible": true,
            "threshold_min": 5.0,
