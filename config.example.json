        },
        "windscreen_temp_C": {
            "enabled": true,
            "visible": true,
            "threshold_min": 10.0,
            "threshold_max": 30.0,
            "unit": "°C",
            "display_name": "Windscreen Temperature",
            "category": "temperature"
        },
        "pitch_degrees": {
            "enabled": true,
            "visible": true,
            "threshold_min": -90.0,
